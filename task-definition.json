{
  "family": "lacrei-api",
  "executionRoleArn": "arn:aws:iam::137769144455:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "lacrei-api",
      "image": "137769144455.dkr.ecr.sa-east-1.amazonaws.com/lacrei-api:latest",
      "cpu": 0,
      "essential": true,

      "portMappings": [
        {
          "containerPort": 443,
          "protocol": "tcp",
          "appProtocol": "http",
          "name": "https"
        }
      ],

      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "3000"
        }
      ],

      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"require('https').get({hostname: 'localhost', port: 443, path: '/status', rejectUnauthorized: false}, (res) => { process.exit(res.statusCode === 200 ? 0 : 1); }).on('error', () => process.exit(1));\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },

      "mountPoints": [],
      "volumesFrom": [],

      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/lacrei-api",
          "awslogs-create-group": "true",
          "awslogs-region": "sa-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],

  "volumes": [],

  "requiresCompatibilities": [
    "FARGATE"
  ],

  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },

  "cpu": "256",
  "memory": "512"
}